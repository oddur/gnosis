---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getReleases, releasesUrl } from '../lib/releases';
import { marked } from 'marked';
const { releases, unavailable } = await getReleases();
function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
}
// Release Markdown is authored by the repository's maintainers, like website source.
function renderBody(body: string) {
  return marked.parse(body, { gfm: true, async: false });
}
---

<Base title="Changelog — Gnosis" description="What's new in Gnosis. Release notes and downloads from GitHub.">
  <main id="main" class="changelog frame">
    <header class="changelog-intro">
      <h1>Changelog</h1>
      <div>
        <p>What's new in Gnosis.</p>
        <a href={releasesUrl} class="text-link">
          All releases on GitHub <Icon name="arrow" size={18} />
        </a>
      </div>
    </header>
    {(unavailable || releases.length === 0) && (
      <section class="release-unavailable">
        <h2>Release notes are available on GitHub.</h2>
        <p>We couldn't include them in this version of the site.</p>
        <a class="button button-primary" href={releasesUrl}>
          Open release notes <Icon name="arrow" size={18} />
        </a>
      </section>
    )}
    <ol class="release-list">
      {releases.map((release) => (
        <li class="release">
          <aside class="release-meta">
            <a href={release.html_url} class="release-version">
              {release.tag_name}
            </a>
            <time datetime={release.published_at}>{formatDate(release.published_at)}</time>
            {release.prerelease && <span class="release-preview">Preview release</span>}
          </aside>
          <article>
            <h2>
              {release.name && release.name !== release.tag_name
                ? release.name
                : `Gnosis ${release.tag_name.replace(/^v/, '')}`}
            </h2>
            {release.body?.trim() ? (
              <div class="release-body" set:html={renderBody(release.body)} />
            ) : (
              <p>See the release on GitHub for details and downloads.</p>
            )}
            <a class="text-link" href={release.html_url}>
              Release and downloads <Icon name="arrow" size={17} />
            </a>
          </article>
        </li>
      ))}
    </ol>
  </main>
</Base>
