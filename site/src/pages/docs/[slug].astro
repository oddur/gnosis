---
import { getCollection, render } from 'astro:content';
import Docs from '../../layouts/Docs.astro';
import DocShot from '../../components/docs/DocShot.astro';
import Kbd from '../../components/docs/Kbd.astro';
import Setting from '../../components/docs/Setting.astro';
import Prerelease from '../../components/docs/Prerelease.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
  const pages = entries.map((entry) => ({ id: entry.id, title: entry.data.title, prerelease: entry.data.prerelease }));
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry, pages } }));
}

const { entry, pages } = Astro.props;
const { Content, headings } = await render(entry);
---

<Docs
  title={entry.data.title}
  description={entry.data.description}
  pages={pages}
  current={entry.id}
  prerelease={entry.data.prerelease}
  headings={headings}
>
  <Content components={{ DocShot, Kbd, Setting, Prerelease }} />
</Docs>
