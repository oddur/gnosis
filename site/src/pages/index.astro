---
import Base from '../layouts/Base.astro';

interface Feature {
  label: string;
  body: string;
}

interface Section {
  num: string;
  title: string;
  intro?: string;
  features: Feature[];
}

const sections: Section[] = [
  {
    num: '01',
    title: 'Read it like a paper.',
    intro:
      'Reviews open as a guided slideshow — narrated, ordered, and grounded in the diff. Each slide explains why something changed before it shows you what changed.',
    features: [
      {
        label: 'Guided slideshow',
        body:
          "Changes are grouped by theme and ordered by dependency — foundations first, then implementations, then tests and config — not by filename. The order matters; you read context before consequences.",
      },
      {
        label: 'Risk assessment',
        body:
          'Each review is rated low, medium, or high risk based on what changed. Critical slides — auth, data integrity, public APIs — are flagged so you read them with sharper eyes.',
      },
      {
        label: 'Mermaid diagrams',
        body:
          'Slides can include sequence, flowchart, and class diagrams when the change benefits from a picture. Click to open fullscreen.',
      },
      {
        label: 'Split or unified diff',
        body:
          'Toggle between side-by-side and inline diff layouts at any time. Your preference persists across sessions.',
      },
    ],
  },
  {
    num: '02',
    title: 'Targeted things to check.',
    intro:
      'Every slide ends with two to four "What to check" prompts grounded in the actual code. Each one is a specific question — not a generic checklist item — anchored to a file and line so a click jumps you straight to the spot.',
    features: [
      {
        label: 'Anchored review checks',
        body:
          "Click a check to scroll to the exact line it's about. The line flashes briefly so you don't lose your place.",
      },
      {
        label: 'Persistent check-offs',
        body:
          'Tick each check as you verify it. The marks survive restarts and PR head changes are tracked separately, so an updated review starts fresh without losing the old one.',
      },
      {
        label: 'Copy as agent prompt',
        body:
          "A small icon next to each check copies a ready-to-paste prompt for Claude Code, Cursor, or any other agent — including the slide title, PR URL, and file:line so the agent can investigate without further setup.",
      },
      {
        label: 'Inline GitHub comments',
        body:
          'Add comments on specific diff lines and submit directly to GitHub as an approval, request for changes, or comment. No copy-pasting between tabs.',
      },
    ],
  },
  {
    num: '03',
    title: 'Aware of your project.',
    intro:
      "Gnosis reads more than the diff. It picks up the conventions the team has already written down — and lets you pull in extra context when the diff alone isn't enough.",
    features: [
      {
        label: 'Project Claude conventions',
        body:
          "Reads CLAUDE.md and the .claude/ folder of the repo it's reviewing. Custom commands, agents, and skills the team has built become part of the reviewer's context — filtered to ones that signal review relevance, not generic dev tooling.",
      },
      {
        label: 'Education mode',
        body:
          'Each slide can include short explainers for concepts the code assumes you already know — "Unit of Work", "CORS preflight", "idempotency key" — so you can follow along without breaking flow to look something up.',
      },
      {
        label: 'Web research',
        body:
          'Optionally let the model search framework docs and best-practice references during generation. Sources are cited on the overview slide.',
      },
      {
        label: 'GitHub MCP context',
        body:
          'Optionally let the model query related GitHub state — issues, sibling PRs, file contents at other refs — through MCP. Useful when a PR references discussions or earlier work.',
      },
      {
        label: 'Smart imports',
        body:
          "A fast model detects local file imports across all languages — C#, Rust, Python, Go — so reviewers get import context beyond what regex catches in the JS/TS world.",
      },
      {
        label: 'Custom instructions',
        body:
          'Steer any review with free-text prompts. "Focus on security." "Explain the auth flow." "I\u2019m not familiar with this domain — assume nothing." The model treats these as authoritative.',
      },
    ],
  },
  {
    num: '04',
    title: 'Workflow that fits the day.',
    intro:
      'You shouldn\u2019t have to babysit a review. Gnosis runs in the background, wakes you when reviews are ready, and remembers everything you\u2019ve already worked through.',
    features: [
      {
        label: 'Proactive mode',
        body:
          'Watches your PRs, your assigned reviews, and any repos you pin. Reviews are waiting in the Archives when you open the app, regenerated whenever the PR head changes.',
      },
      {
        label: 'Background generation',
        body:
          'Reviews stream while you keep working. Submit several at once, browse existing reviews, or close the app entirely — generation continues and tray status shows progress.',
      },
      {
        label: 'Menu-bar tray',
        body:
          'Quick view of pending reviews, currently-generating jobs, and CI status for watched PRs without opening the window.',
      },
      {
        label: 'Slide chat',
        body:
          'Ask follow-up questions about any slide in an inline resizable side panel. Tool-call indicators show what the model is doing while it answers.',
      },
      {
        label: 'Selection-to-chat',
        body:
          'Highlight code anywhere in the diff and ask about exactly that snippet — no need to paste it into the chat by hand.',
      },
      {
        label: 'Stale review detection',
        body:
          "If a PR receives new commits after your review was generated, a banner shows what changed and offers to re-generate. Old reviews aren\u2019t silently discarded.",
      },
    ],
  },
  {
    num: '05',
    title: 'Local-first by design.',
    intro:
      "Your code stays on your machine. Reviews run against the Claude or Gemini CLI you already have installed. There is no Gnosis server in the loop.",
    features: [
      {
        label: 'Multi-provider',
        body:
          'Claude (Opus 4.7, Sonnet 4.6, Haiku 4.5) or Gemini (3.1 Pro, 3 Pro, 3 Flash, 2.5 Pro, 2.5 Flash). Switch per review, or set different defaults for manual vs. proactive runs.',
      },
      {
        label: 'Extended thinking',
        body:
          'Enable deeper reasoning for Claude models when the diff warrants it. Off by default for proactive mode to keep cost predictable.',
      },
      {
        label: 'Parallel writers',
        body:
          'Large PRs split into a planner pass plus parallel writers per topic. Faster than one long sequential generation, with consistent narrative across slides.',
      },
      {
        label: 'Signal boost',
        body:
          'Filters out trivial changes — whitespace, import reordering, boilerplate — and focuses the review on design decisions, complexity, and API surface.',
      },
      {
        label: 'Large file filtering',
        body:
          'Generated artefacts (lockfiles, bundles, minified output) are detected and excluded automatically so the model spends its context on changes that matter.',
      },
      {
        label: 'Privacy-first analytics (opt-out)',
        body:
          'Anonymous app-usage events go to Aptabase, an open-source privacy-first service. No personal data, no IP addresses, no PR contents, no source code. Switch off in Settings.',
      },
    ],
  },
  {
    num: '06',
    title: 'Pass it along.',
    intro:
      "Reviews shouldn\u2019t live in one head. Send a finished review to a teammate as a single file — or browse and re-open everything you've already reviewed.",
    features: [
      {
        label: 'Export as .gr',
        body:
          "Any review exports to a single .gr archive — review JSON, history entry, and the original prompt. Send it to a teammate via Slack, email, or anywhere a file fits.",
      },
      {
        label: 'Import .gr',
        body:
          "Drop a .gr file into Gnosis and it appears in your Archives as if you'd generated it locally. Useful for handoffs, second opinions, and onboarding new team members onto a complex change.",
      },
      {
        label: 'Local review history',
        body:
          'Every past review is saved on disk and grouped by PR on the home screen. Click any to reload without re-generating.',
      },
      {
        label: 'PR browser',
        body:
          'Browse your open PRs and assigned review requests instead of pasting URLs. Two-click reviews from your inbox.',
      },
    ],
  },
  {
    num: '07',
    title: 'Editorial polish.',
    intro:
      "Reviewing code is a reading task. Gnosis treats it that way — type, spacing, and motion are tuned for the long, attentive sit, not the dashboard scan.",
    features: [
      {
        label: 'Editorial type',
        body:
          'Fraunces serif for headlines, Plus Jakarta Sans for prose, JetBrains Mono for code and meta. Tuned for the editorial measure (~68 characters per line) so prose stays readable and the diff stays code.',
      },
      {
        label: 'Light and dark, both first-class',
        body:
          'Both modes are tested against WCAG AA. Warm OKLCH paper or warm OKLCH study — no cool blue gradients, no "dark mode is just inverted" surprises.',
      },
      {
        label: 'Code appearance',
        body:
          'Pick your code font and syntax theme in Settings. Choices persist across reviews and re-render existing reviews on the fly.',
      },
      {
        label: 'Auto-update',
        body:
          'New releases download and install in the background on macOS and Windows. Linux gets an in-app banner pointing at the relevant package.',
      },
      {
        label: 'Cross-platform',
        body:
          'Builds for macOS (signed + notarized), Windows, and Linux (deb + rpm).',
      },
    ],
  },
];
---

<Base title="Gnosis — AI-guided code review">
  <main class="mx-auto max-w-3xl px-6 py-16 sm:py-24 flex flex-col gap-16">
    <!-- Masthead -->
    <header class="flex flex-col gap-5">
      <p class="slide-chapter">
        <span>Gnosis</span>
        <span aria-hidden="true">·</span>
        <span>local desktop app</span>
        <span aria-hidden="true">·</span>
        <span>v0.19</span>
      </p>
      <h1 class="slide-title">
        Understand the pull request before you read the diff.
      </h1>
      <p class="slide-prose text-[color:var(--muted-foreground)]">
        <em>Gnosis</em> is an ancient Greek word for knowledge — not the surface kind, but the deep, direct understanding of a thing. The Gnostics used it for insight that comes from within, from truly comprehending something rather than just observing it from the outside. That's what's missing from most code reviews: you see the diff, but you don't get the understanding. Gnosis tries to close that gap.
      </p>
      <div class="flex flex-wrap items-center gap-3 mt-2">
        <a class="btn-ink" href="https://github.com/oddur/gnosis/releases/latest" rel="noopener">
          Download for macOS
        </a>
        <a class="btn-quiet" href="https://github.com/oddur/gnosis" rel="noopener">
          View on GitHub
        </a>
      </div>
      <p class="slide-meta">
        Also for Windows and Linux on the
        <a class="link-claret" href="https://github.com/oddur/gnosis/releases/latest" rel="noopener">releases page</a>.
        Or:
        <code class="font-mono text-foreground">brew tap oddur/gnosis && brew install --cask gnosis</code>
      </p>
    </header>

    <!-- The premise -->
    <section class="hairline pt-12 flex flex-col gap-4">
      <p class="slide-chapter">The premise</p>
      <p class="slide-prose text-[color:var(--muted-foreground)]">
        We've gotten fast at writing code. Reviewing it hasn't kept up. Pull requests are still reviewed the same way they always have been — scrolling through file diffs in whatever order GitHub decides to show them, with no grouping, no context, and no sense of which changes depend on which. It works, but it's slow, and it's easy to miss things.
      </p>
      <p class="slide-prose text-[color:var(--muted-foreground)]">
        Gnosis paste-a-PR-URL, then reads the diff, groups related changes, and presents them as an ordered slideshow. Foundation changes first, then the features built on top, then tests and config. Each slide has a short explanation of <em>why</em> the change exists, the relevant diff, and optionally a diagram. The goal is to walk you through the change the way the author understands it, not the way the filesystem happens to order it.
      </p>
      <p class="slide-prose text-[color:var(--muted-foreground)]">
        It runs locally and uses the
        <a class="link-claret" href="https://claude.ai/code" rel="noopener">Claude Code CLI</a>
        or the
        <a class="link-claret" href="https://github.com/google-gemini/gemini-cli" rel="noopener">Gemini CLI</a>
        you already have installed.
      </p>
    </section>

    <!-- Themed feature sections -->
    {sections.map((s) => (
      <section class="hairline pt-12 flex flex-col gap-6">
        <header class="flex flex-col gap-3">
          <div class="flex items-baseline gap-3">
            <span class="slide-chapter">{s.num}</span>
            <h2 class="editorial-heading">{s.title}</h2>
          </div>
          {s.intro && (
            <p class="slide-prose text-[color:var(--muted-foreground)]">{s.intro}</p>
          )}
        </header>
        <ul class="flex flex-col gap-4 list-none p-0 m-0">
          {s.features.map((f) => (
            <li class="slide-prose text-[color:var(--muted-foreground)]">
              <span class="editorial-label">{f.label}.</span> {f.body}
            </li>
          ))}
        </ul>
      </section>
    ))}

    <!-- Requirements -->
    <section class="hairline pt-12 flex flex-col gap-4">
      <p class="slide-chapter">Requirements</p>
      <p class="slide-prose text-[color:var(--muted-foreground)]">
        At least one of the following CLIs installed and authenticated:
      </p>
      <ul class="slide-prose text-[color:var(--muted-foreground)] flex flex-col gap-1 list-none p-0">
        <li>•&nbsp; <a class="link-claret" href="https://claude.ai/code" rel="noopener">Claude Code CLI</a> — authenticate with <code class="font-mono text-foreground">claude auth</code>.</li>
        <li>•&nbsp; <a class="link-claret" href="https://github.com/google-gemini/gemini-cli" rel="noopener">Gemini CLI</a></li>
      </ul>
      <p class="slide-prose text-[color:var(--muted-foreground)]">
        On first launch, sign in with GitHub via OAuth — or paste a PAT if your org blocks the OAuth flow.
      </p>
    </section>

    <!-- Footer -->
    <footer class="hairline pt-8 flex flex-col gap-2 slide-meta">
      <p>
        <a class="link-claret" href="https://github.com/oddur/gnosis" rel="noopener">github.com/oddur/gnosis</a>
        · MIT licence
      </p>
      <p>An experiment in changing how code review feels.</p>
    </footer>
  </main>
</Base>
