---
import Base from '../layouts/Base.astro';
import StackDemo from '../components/StackDemo.astro';
import FeatureTour from '../components/FeatureTour.astro';
import ProductShot from '../components/ProductShot.astro';
import Icon from '../components/Icon.astro';
import { getReleases, releasesUrl } from '../lib/releases';
const { releases } = await getReleases();
const latest = releases.find((release) => !release.prerelease);
const macDownload = latest?.assets.find((asset) => asset.name === 'Gnosis.dmg')?.browser_download_url;
const brewCommand = 'brew tap oddur/gnosis && brew install --cask gnosis';
---

<Base title="Gnosis — A desktop app for code review">
  <main id="main">
    <section class="opening frame" aria-labelledby="headline">
      <div class="hero-intro">
        <h1 id="headline">
          Understand the code
          <br />
          you’re reviewing.
        </h1>
        <p>
          An open-source desktop app for GitHub pull requests. Review stacks, read diffs, and generate explanations with
          your local coding agent.
        </p>
      </div>
      <StackDemo />
      <nav class="project-links" aria-label="Project resources">
        <a href="https://github.com/oddur/gnosis">
          Source on GitHub <Icon name="arrow" size={16} />
        </a>
        <a href="https://github.com/oddur/gnosis#readme">Setup guide</a>
        <a href="https://github.com/oddur/gnosis/issues">Bugs &amp; ideas</a>
        <span>Free · MIT license</span>
      </nav>
    </section>

    <section class="inside-section" id="inside" aria-labelledby="queue-title">
      <div class="frame">
        <div class="section-intro">
          <h2 id="queue-title">A queue for your PRs</h2>
          <div>
            <p>Track review requests, unread changes, and stacked PRs across repositories.</p>
            <p>Get a short AI briefing before opening a diff. Save filters for the PRs you want to follow.</p>
          </div>
        </div>
        <ProductShot
          name="review-queue"
          alt="Gnosis Review queue with review requests, a grouped PR stack, check results, and its briefing beside the list."
          caption="A briefing for the selected stack, beside the review queue."
        />
        <div class="feature-line">
          <span>Saved filters</span>
          <span>Unread updates</span>
          <span>Automatic briefings</span>
          <span>Grouped stacks</span>
        </div>
      </div>
    </section>

    <section class="review-section frame" aria-labelledby="review-title">
      <div class="section-intro">
        <h2 id="review-title">Explanations beside the diff</h2>
        <div>
          <p>
            Generate an explanation for a PR or a whole stack. It breaks the change into topics, with diagrams and notes
            attached to the code.
          </p>
          <p>You can also open Changes or Commits and review the code without generating anything.</p>
        </div>
      </div>
      <ProductShot
        name="guided-review"
        alt="A Gnosis guided explanation beside the source diff, with an inline explanation of an await expression and a Review PR action."
        caption="An inline explanation of why the worker call is awaited."
      />
      <div class="review-footnote">
        <p>Explanations use Claude Code or Codex. You review the code and decide what to submit.</p>
        <a href="#example">
          Play the sample diagram <Icon name="arrow" size={18} />
        </a>
      </div>
    </section>

    <FeatureTour />

    <section class="daily-section frame" aria-labelledby="daily-title">
      <div class="section-intro">
        <h2 id="daily-title">Also included</h2>
      </div>
      <dl class="daily-features">
        <div>
          <dt>Saved filters</dt>
          <dd>
            Save views by repository, author, labels, read status, or target branch—including patterns such as{' '}
            <code>release/*</code>.
          </dd>
        </div>
        <div>
          <dt>Mute, star, and repository settings</dt>
          <dd>
            Mute PRs, star the ones to revisit, and set repository rules for Dependabot, inactivity, and automatic
            briefings.
          </dd>
        </div>
        <div>
          <dt>Local search with ⌘K</dt>
          <dd>
            Search locally available PRs, files, and saved explanations. Use recent destinations to get back to a
            review.
          </dd>
        </div>
        <div>
          <dt>GitHub comments and reviews</dt>
          <dd>
            Read GitHub threads inline. Draft comments with a Markdown preview, then submit them with your review
            decision.
          </dd>
        </div>
        <div>
          <dt>Images, SVGs, and Git LFS</dt>
          <dd>
            Compare images and SVGs, recognize moved files, and download Git LFS resources when you need to inspect
            them.
          </dd>
        </div>
        <div>
          <dt>Local cache and review progress</dt>
          <dd>
            Keep viewed-file progress and saved explanations. Background preloading puts GitHub content in the local
            cache ahead of your next visit.
          </dd>
        </div>
      </dl>
    </section>

    <section class="setup-section" aria-labelledby="setup-title">
      <div class="frame setup-layout">
        <div>
          <h2 id="setup-title">Uses your local coding agent</h2>
          <p class="setup-lead">
            Gnosis runs Claude Code or Codex CLI on your machine, using the login you already have. AI usage goes
            through your existing subscription or API billing. There’s no Gnosis subscription.
          </p>
          <a href="https://github.com/oddur/gnosis#readme" class="text-link">
            Read the setup guide <Icon name="arrow" size={18} />
          </a>
        </div>
        <div class="setup-steps">
          <div>
            <h3>Connect GitHub</h3>
            <p>Choose which repositories to watch. Set filters and briefing preferences per repository.</p>
          </div>
          <div>
            <h3>Choose your models</h3>
            <p>Use Claude, Codex, or both. Pick separate models and effort levels for explanations and briefings.</p>
          </div>
          <div>
            <h3>Use a local clone if you have one</h3>
            <p>Link a repository to its local clone in Settings. Gnosis can read Git data from it.</p>
          </div>
        </div>
        <p class="data-note">
          Gnosis runs on your computer. AI requests send code and context to your selected provider under your account.
        </p>
      </div>
    </section>

    <section class="download-section frame" id="download" aria-labelledby="download-title">
      <div class="download-heading">
        <h2 id="download-title">Install Gnosis</h2>
        <p>Download the app or use Homebrew.</p>
      </div>
      <div class="install-options">
        <div class="direct-download">
          <a class="button button-primary button-large" href={macDownload ?? `${releasesUrl}/latest`}>
            <Icon name="download" />
            {macDownload ? 'Download for macOS' : 'View latest downloads'}
          </a>
          <p>
            {latest ? `${latest.tag_name} · ` : ''}Apple silicon<span aria-hidden="true"> · </span>
            <a href={releasesUrl}>All downloads</a>
          </p>
        </div>
        <div class="brew-install">
          <label for="brew-command">Or install with Homebrew</label>
          <div class="command-copy">
            <code id="brew-command">{brewCommand}</code>
            <button
              class="icon-button"
              type="button"
              id="copy-brew"
              aria-label="Copy Homebrew install command"
              title="Copy install command"
              hidden
            >
              <Icon name="copy" size={19} />
            </button>
          </div>
          <p id="copy-status" class="copy-status" role="status" aria-live="polite">
            Connect GitHub for PRs. Install Claude Code or Codex for AI features.
          </p>
        </div>
      </div>
    </section>
  </main>
  <script>
    const copy = document.querySelector<HTMLButtonElement>('#copy-brew');
    if (copy) {
      copy.hidden = false;
      copy.addEventListener('click', async () => {
        const status = document.querySelector('#copy-status')!;
        try {
          await navigator.clipboard.writeText(document.querySelector('#brew-command')!.textContent!.trim());
          status.textContent = 'Install command copied.';
        } catch {
          status.textContent = 'Select the command above and copy it manually.';
        }
      });
    }
  </script>
</Base>
