  ],
  chevron: ['m9 5 7 7-7 7'],
  play: ['m8 5 11 7-11 7V5Z'],
  pause: ['M9 5v14', 'M15 5v14'],
  step: ['m5 5 10 7-10 7V5Z', 'M19 5v14'],
