{
  "name": "gnosis-site",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "test:browser": "node scripts/test-browser.mjs",
    "format": "prettier --plugin prettier-plugin-astro --write \"src/**/*.{astro,css,ts}\" \"scripts/*.mjs\"",
    "test:performance": "node scripts/test-browser.mjs --performance"
  },
  "dependencies": {
    "@aptabase/web": "^0.5.0",
    "@astrojs/check": "^0.9.4",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^5.1.5",
    "marked": "^18.0.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "axe-core": "^4.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2"
  }
}
