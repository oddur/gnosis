        "export interface CacheConfig {",
        "  megabytes: number;",
        "  directory: string;",
        "}",
        "",
        "export const DEFAULT_MEGABYTES = 256;",
        "",
        "export function describe(value: number): string {",
        "  if (value < 0) return 'negative';",
        "  if (value === 0) return 'zero';",
        "  if (value < 10) return 'small';",
        "  if (value < 100) return 'medium';",
        "  return 'large';",
        "}",
        "",
        "export function cacheConfig(env: Record<string, string | undefined>): CacheConfig {",
        "  const megabytes = Number(env.CACHE_MB);",
        "  return {",
