{
  "id": "removed-guard",
  "title": "Fix the race when counting files",
  "description": "Counting no longer checks existence first; a missing directory is handled by the read.",
  "source": "backtrack #6 and #12: an early-return guard and a drop() removed. They read like dead code but change behavior.",
  "files": [
    {
      "path": "src/count.rs",
      "before": [
        "pub fn count(dir: &Path) -> io::Result<(u64, u64)> {",
        "    if !dir.exists() {",
        "        return Ok((0, 0));",
        "    }",
        "    let entries = match fs::read_dir(dir) {",
        "        Ok(entries) => entries,",
        "        Err(error) => return Err(error),",
        "    };",
        "    tally(entries)",
        "}"
      ],
      "after": [
        "pub fn count(dir: &Path) -> io::Result<(u64, u64)> {",
        "    let entries = match fs::read_dir(dir) {",
        "        Ok(entries) => entries,",
        "        Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok((0, 0)),",
        "        Err(error) => return Err(error),",
        "    };",
        "    tally(entries)",
        "}"
      ],
      "hunks": [
        {
          "label": "essential",
          "note": "Guard removed and NotFound handled in the read (one hunk).",
          "behavior": true
        }
      ]
    },
    {
      "path": "src/main.rs",
      "before": [
        "fn main() {",
        "    let guard = telemetry::init();",
        "    let code = run();",
        "    // The telemetry client must flush before the process exits.",
        "    drop(guard);",
        "    std::process::exit(code);",
        "}"
      ],
      "after": [
        "fn main() {",
        "    let guard = telemetry::init();",
        "    let code = run();",
        "    std::process::exit(code);",
        "}"
      ],
      "hunks": [
        {
          "label": "essential",
          "note": "Removing the drop skips the telemetry flush.",
          "behavior": true
        }
      ]
    }
  ]
}
